APP_NAME=ReviewFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Database (XAMPP MySQL) ----
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=reviewflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# ---- Google Gemini AI (free key: https://aistudio.google.com/app/apikey) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Razorpay (test keys from dashboard.razorpay.com) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Google Business Profile / Ads (OAuth, server-side) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/google/callback

# ---- Google Places API (separate key — powers Local Rank Checker) ----
GOOGLE_PLACES_API_KEY=

# ---- Meta (Graph + Marketing) ----
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/meta/callback

# ---- WhatsApp Cloud API ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
